# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Security
JWT_SECRET=super_secure_task_manager_jwt_secret_key_987654321_!@#
JWT_EXPIRES_IN=24h

# Database Configuration (MySQL)
# Default is 'mysql' (using your local MySQL80 service)
# Fallback to 'sqlite' if you want zero-setup local file testing
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD_HERE
DB_NAME=secure_task_manager

# Client URL for CORS
CLIENT_URL=http://localhost:5173
